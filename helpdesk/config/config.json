{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "helpdesk-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/helpdesk/HelpdeskWebPart.js",
          "manifest": "./src/webparts/helpdesk/HelpdeskWebPart.manifest.json"
        }
      ]
    },
    "admin-helpdesk-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/adminHelpdesk/AdminHelpdeskWebPart.js",
          "manifest": "./src/webparts/adminHelpdesk/AdminHelpdeskWebPart.manifest.json"
        }
      ]
    },
    "agent-human-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/agenthuman/AgentHumanWebPart.js",
          "manifest": "./src/webparts/agenthuman/AgentHumanWebPart.manifest.json"
        }
      ]
    },
    "agent-ai-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/agentAI/AgentAIWebPart.js",
          "manifest": "./src/webparts/agentAI/AgentAIWebPart.manifest.json"
        }
      ]
    },
    "notification-header-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/notificationHeader/NotificationHeaderApplicationCustomizer.js",
          "manifest": "./src/extensions/notificationHeader/NotificationHeaderApplicationCustomizer.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "HelpdeskWebPartStrings": "lib/webparts/helpdesk/loc/{locale}.js",
    "AdminHelpdeskWebPartStrings": "lib/webparts/adminHelpdesk/loc/{locale}.js",
    "AgentHumanWebPartStrings": "lib/webparts/agenthuman/loc/{locale}.js",
    "AgentAIWebPartStrings": "lib/webparts/agentAI/loc/{locale}.js"
  }
}
